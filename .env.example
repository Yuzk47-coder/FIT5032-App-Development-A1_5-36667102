# A3 D.1 External Authentication (Firebase Authentication)
# Copy this file to .env and paste the Web App configuration from your
# EXISTING Firebase project. Do not put billing/payment details here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# A3 D.2 Email API (EmailJS)
# Free plan is enough for the required booking-confirmation demonstration.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
